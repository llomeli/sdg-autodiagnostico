# Copia a .env (o deja que ./install.sh lo genere con secretos aleatorios). Nunca lo subas a Git.

# Publicación local del contenedor web. Mantén 127.0.0.1 y publica a través de un proxy HTTPS.
APP_BIND=127.0.0.1
APP_PORT=3000

# Base de datos MySQL (no se publica fuera de la red de Docker)
MYSQL_DATABASE=sdg_lead_magnet
MYSQL_USER=sdg_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_VALUE

# Modo autónomo: no usa Manus OAuth ni Manus Storage
SELF_HOSTED_MODE=true

# Acceso al panel /admin (mínimo 16 caracteres; la app no arranca con valores débiles)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_VALUE
LOCAL_ADMIN_NAME="Administrador SDG"
# Duración de la sesión del panel, en horas. Cambiar la contraseña invalida todas las sesiones.
ADMIN_SESSION_HOURS=8

# Clave para firmar sesiones (mínimo 32 caracteres aleatorios)
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Proxy inverso y cookies
#   TRUST_PROXY: con Docker Compose y proxy en el host usa "loopback,uniquelocal" (el tráfico llega desde la
#   puerta de enlace del bridge 172.x). Sin Docker: "loopback". También acepta saltos ("1") o IP/CIDR.
#   COOKIE_SECURE=true en cuanto haya HTTPS (activa también HSTS).
TRUST_PROXY="loopback,uniquelocal"
COOKIE_SECURE=false

# Antiabuso (por IP)
SUBMIT_RATE_LIMIT_PER_HOUR=10
LOGIN_RATE_LIMIT_PER_15MIN=10

# Aviso de Privacidad aprobado por Legal: se muestra en el formulario y se guarda su versión con cada consentimiento.
# VITE_* se incorporan en el build: tras cambiarlos ejecuta "docker compose up -d --build".
PRIVACY_NOTICE_VERSION=
VITE_PRIVACY_NOTICE_URL=
VITE_LEGAL_ENTITY_NAME=
